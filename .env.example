# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# E-mail vérifié sur Resend (ex. onboarding@resend.dev ou votre domaine)
RESEND_FROM_EMAIL=Capitaine Depan <onboarding@resend.dev>

# Destinataire des demandes de devis
RESEND_TO_EMAIL=votre@email.fr

# Port API locale (optionnel, défaut 3001)
API_PORT=3001

# URL publique du site (SEO, canonical, schema.org)
VITE_SITE_URL=https://capitaine-depann.fr

# Analytics — un seul des deux (bannière cookies requise)
# Plausible (recommandé, respectueux RGPD)
VITE_PLAUSIBLE_DOMAIN=capitaine-depann.fr
# Ou Google Analytics 4
# VITE_GA4_ID=G-XXXXXXXXXX
