# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# E-mail vérifié sur Resend (domaine capitainedepan.com)
RESEND_FROM_EMAIL=Capitaine Depan <contact@capitainedepan.com>

# Destinataire des demandes de devis
RESEND_TO_EMAIL=votre@email.fr

# Port API locale (optionnel, défaut 3001)
API_PORT=3001

# URL publique du site (SEO, canonical, schema.org)
VITE_SITE_URL=https://capitainedepan.com

# Analytics — un seul des deux (bannière cookies requise)
VITE_PLAUSIBLE_DOMAIN=capitainedepan.com
